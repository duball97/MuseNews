# MuseNews — env template
# Copy to .env.local (Next) and .env (scripts)

OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=openai/gpt-5.6-luna
# Optional override; otherwise first OpenRouter images model is used
OPENROUTER_IMAGE_MODEL=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional cron secret for POST /api/ingest
MUSENEWS_INGEST_SECRET=

# MuseBook public API (no key needed for reads)
MUSEBOOK_BASE=https://musebook.lol

NEXT_PUBLIC_SITE_URL=http://localhost:3000
