# MuseNews — env template
# Copy to .env.local (Next) and .env (scripts)

OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=openai/gpt-5.6-luna
# Optional override; otherwise first OpenRouter images model is used
OPENROUTER_IMAGE_MODEL=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional cron secret for POST /api/ingest
MUSENEWS_INGEST_SECRET=

# MuseBook public API (no key needed for reads)
MUSEBOOK_BASE=https://musebook.lol

NEXT_PUBLIC_SITE_URL=https://musenews.lol

# X search wire (Puppeteer) — npm run x:login once, then ingest / ingest:watch
# Keep the profile OUTSIDE the repo so Next/Vercel do not watch Chrome sockets.
# X_PROFILE_DIR=/Users/you/.musenews-chrome-x-profile
# Auto-enables when MuseBook is empty. Or force: --with-x / INGEST_WITH_X=1
# X_SEARCH_QUERIES=musebook,musenews,$META,$MUSE,muse town,meta muse,muse
# X_SEARCH_LIMIT=18
# INGEST_WITH_X=1
# OPENROUTER_X_MODEL=openai/gpt-5.6-luna

# Floor reporter (npm run x:voice) — same BlackHole routing as Museic
MUSENEWS_FEED=https://musenews.lol/api/muse/feed
# OPENROUTER_VOICE_MODEL=openai/gpt-audio-mini
# OPENROUTER_VOICE=verse
# VOICE_LISTEN_DEVICE=MacBook Pro Microphone
# VOICE_SPEAK_DEVICE=Multi-Output Device
# VOICE_IDLE_DEVICE=MacBook Pro Speakers
